#### #### #### #### #### #### #### ####
chicago_pheb_df <- plot_hierarchical_edge_bundling %>%
filter(location == "chicago")
#rm(vertices)  # Remove any previous conflicting object
# Ensure `all_stations` is defined correctly (replace this with your actual station list)
all_stations <- unique(c(as.character(chicago_pheb_df$start.station), as.character(chicago_pheb_df$end.station)))
# Re-create the `vertices` data frame correctly
vertices <- data.frame(
name = unique(c(as.character(chicago_pheb_df$start.station), as.character(chicago_pheb_df$end.station))),
value = runif(length(unique(c(as.character(chicago_pheb_df$start.station), as.character(chicago_pheb_df$end.station)))))
)
# Check if any stations are missing in vertices
#missing_stations <- setdiff(all_stations, vertices$name)
missing_stations <- setdiff(all_stations, vertices[["name"]])
# If there are missing stations, you can add them to the vertices dataframe
if(length(missing_stations) > 0) {
missing_vertices <- data.frame(
name = missing_stations,
value = runif(length(missing_stations))  # Generate random values for the missing stations
)
# Append missing stations to the vertices data frame
vertices <- rbind(vertices, missing_vertices)
}
# 3. Create the graph again, now that all stations are included
mygraph <- igraph::graph_from_data_frame(chicago_pheb_df, vertices = vertices)
#### #### #### #### #### #### #### ####
# Removes all previously created variables.
# https://youtu.be/D_CNmYkGRUc?si=PJJbZY0GBtVsB4dB&t=91
rm(list=ls())
gc()
